; Open-head removal uses the erased clauses' arities without binding the pattern.
(= (open-bar) 0)
(= (open-bar 1) 10)
(= (open-bar 1 2) 20)
(= (open-caller $x) (open-bar $x))
(= (open-caller2 $x $y) (open-bar $x $y))
!(test (collapse (open-caller 1)) (10))
!(test (collapse (open-caller2 1 2)) (20))
!(test (let $head (cons-atom open-bar $args)
          (let $pat (cons-atom = ($head $body))
             (let $removed (remove-atom &self $pat)
                ($removed (is-var $args) (is-var $body))))) (True True True))
!(test (collapse (match &self (= (open-bar) $body) $body)) ())
!(test (collapse (match &self (= (open-bar $x) $body) $body)) ())
!(test (collapse (match &self (= (open-bar $x $y) $body) $body)) ())
!(test (collapse (open-caller 1)) ((open-bar 1)))
!(test (collapse (open-caller2 1 2)) ((open-bar 1 2)))
!(test (let $head (cons-atom open-bar $args)
          (let $pat (cons-atom = ($head $body))
             (let $removed (remove-atom &self $pat)
                ($removed (is-var $args))))) (False True))
